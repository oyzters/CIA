{
  "manifest_version": 3,
  "name": "CIA Wrap",
  "version": "0.1.0",
  "description": "Interfaz moderna sobre el portal CIA / PeopleSoft de ITSON. Corre en tu propia sesion; no toca el servidor ni credenciales.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "*://smartweb1.itson.edu.mx/*",
        "*://smartweb2.itson.edu.mx/*",
        "*://apps9.itson.edu.mx/*"
      ],
      "css": ["content.css", "shell.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CIA Wrap",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["assets/logo-dark.png", "assets/logo-light.png"],
      "matches": ["*://smartweb1.itson.edu.mx/*", "*://smartweb2.itson.edu.mx/*", "*://apps9.itson.edu.mx/*"]
    }
  ]
}
